# 复制为 .env 用于本地调试,真实值放 GitHub Actions Secrets
DEEPSEEK_API_KEY=your_deepseek_key_here

# ---- 发送渠道 1: QQ 邮箱 (推荐) ----
# 开启方式: QQ 邮箱 → 设置 → 账户 → 开启「SMTP 服务」,生成授权码 (不是 QQ 密码)
QQ_SMTP_USER=your_qq_mail@qq.com
QQ_SMTP_AUTH_CODE=your_qq_smtp_auth_code
MAIL_TO=recipient@example.com   # 收件人,多个用英文逗号分隔

# ---- 发送渠道 2: Telegram (可选;不配这两个就只走 QQ 邮箱) ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 可选:覆盖默认配置
# HOURS_LOOKBACK=24
# MAX_TWEETS_PER_BLOGGER=5
# DEEPSEEK_MODEL=deepseek-v4-pro   # 默认旗舰;可选 deepseek-v4-flash / deepseek-chat
# DEEPSEEK_THINKING=1              # 1 开启深度思考(仅 pro/reasoner 生效),0 关闭
